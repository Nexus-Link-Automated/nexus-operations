PORT=3420
# The Plane API. The gateway forwards the browser's session cookie to it to ask who is signed in and what they may see.
API_BASE_URL="http://localhost:8000"
# The Redis the API publishes chat events to (the same value as the API's REDIS_URL).
REDIS_URL="redis://localhost:6379/"
CHAT_GATEWAY_BASE_PATH="/chat"
# Browser origins allowed to open the socket (comma separated). Empty: same host only.
CORS_ALLOWED_ORIGINS="http://localhost:3000"
