# syntax=docker/dockerfile:1.7
# The chat gateway: pushes Nexus Messages events to browsers over WebSocket. It never writes data, so it
# holds no database credentials and no secrets of its own: it asks the API about the user's own cookie.
FROM node:24-alpine AS base

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PNPM_HOME/bin:$PATH"
RUN corepack enable

# *****************************************************************************
# STAGE 1: Prune the monorepo down to chat-gateway and its workspace dependencies
# *****************************************************************************
FROM base AS builder
RUN apk add --no-cache libc6-compat
WORKDIR /app
ARG TURBO_VERSION=2.10.11
RUN corepack enable pnpm && pnpm add -g turbo@${TURBO_VERSION}
COPY . .
RUN turbo prune --scope=chat-gateway --docker

# *****************************************************************************
# STAGE 2: Install dependencies and build
# *****************************************************************************
FROM base AS installer
RUN apk add --no-cache libc6-compat
WORKDIR /app

COPY .gitignore .gitignore
COPY --from=builder /app/out/json/ .
COPY --from=builder /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN corepack enable pnpm

COPY --from=builder /app/out/full/ .
COPY turbo.json turbo.json

RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store pnpm fetch --store-dir=/pnpm/store
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store CI=true pnpm install --offline --frozen-lockfile --store-dir=/pnpm/store

ENV TURBO_TELEMETRY_DISABLED=1
RUN pnpm turbo run build --filter=chat-gateway

# *****************************************************************************
# STAGE 3: Runtime
# *****************************************************************************
FROM base AS runner
WORKDIR /app

ARG APK_SECURITY_PATCH=2026-10-26
RUN echo "apk-security-patch ${APK_SECURITY_PATCH}" && apk update && apk upgrade --no-cache --available
RUN apk del go 2>/dev/null || true
# npm is not used at runtime (CMD is plain node).
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx

COPY --from=installer /app/packages ./packages
COPY --from=installer /app/apps/chat-gateway/dist ./apps/chat-gateway/dist
COPY --from=installer /app/apps/chat-gateway/node_modules ./apps/chat-gateway/node_modules
COPY --from=installer /app/apps/chat-gateway/package.json ./apps/chat-gateway/package.json
COPY --from=installer /app/node_modules ./node_modules

# Build-only Go binaries.
RUN find /app/node_modules \( -name 'esbuild' -o -name 'tsgolint' \) -type f -delete 2>/dev/null || true

ENV NODE_ENV=production
ENV TURBO_TELEMETRY_DISABLED=1
ENV PORT=3420

USER node
EXPOSE 3420
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
  CMD wget -qO- "http://127.0.0.1:${PORT}${CHAT_GATEWAY_BASE_PATH:-/chat}/health" >/dev/null || exit 1

CMD ["node", "apps/chat-gateway/dist/start.mjs"]
