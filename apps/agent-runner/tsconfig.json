{
  "extends": "@plane/typescript-config/node-library.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "types": ["node"]
  },
  "include": ["src/**/*", "tests/**/*"],
  // Fixtures run as separate processes; fake-coding-agent.ts imports the adapters' source, which this project does not build.
  "exclude": ["node_modules", "dist", "tests/fixtures"]
}
